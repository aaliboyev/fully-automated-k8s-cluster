    {
      "type": "stat",
      "title": "Stale backups",
      "description": "Backup jobs past their allowed gap, the BackupStale alert line.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "count((100 * (time() - kube_cronjob_status_last_successful_time{cronjob=~\"backup-.*\",cronjob!~\".*-export\"}) / (36 * 3600) or 100 * (time() - kube_cronjob_status_last_successful_time{cronjob=~\"backup-.*-export\"}) / (8 * 86400)) >= 100) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "#d9367e",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "links": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
