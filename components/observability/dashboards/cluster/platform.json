    {
      "type": "bargauge",
      "title": "Backup age, share of allowed gap",
      "description": "How far each backup is into the gap BackupStale allows: 36 hours for daily jobs, 8 days for weekly ones. At 100% the alert fires.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sort_desc(100 * (time() - kube_cronjob_status_last_successful_time{cronjob=~\"backup-.*\",cronjob!~\".*-export\"}) / (36 * 3600) or 100 * (time() - kube_cronjob_status_last_successful_time{cronjob=~\"backup-.*-export\"}) / (8 * 86400))",
          "legendFormat": "{{namespace}} / {{cronjob}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "#ecd13a",
                "value": 75
              },
              {
                "color": "#d9367e",
                "value": 100
              }
            ]
          },
          "links": [],
          "max": 100,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "namePlacement": "left",
        "showUnfilled": true,
        "sizing": "manual",
        "minVizHeight": 14,
        "maxVizHeight": 18,
        "minVizWidth": 8,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
