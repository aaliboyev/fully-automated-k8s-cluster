    {
      "type": "gauge",
      "title": "CPU requested",
      "description": "CPU promised to pods against what each node can give. A node at 100% refuses new pods however idle it looks.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sort_by_label(100 * sum by (node) (kube_pod_container_resource_requests{resource=\"cpu\"} * on (namespace, pod) group_left () (kube_pod_status_phase{phase=~\"Running|Pending\"} == 1)) / sum by (node) (kube_node_status_allocatable{resource=\"cpu\"}), \"node\")",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#e8743b",
                "value": null
              },
              {
                "color": "#ecd13a",
                "value": 80
              },
              {
                "color": "#d9367e",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75
      },
