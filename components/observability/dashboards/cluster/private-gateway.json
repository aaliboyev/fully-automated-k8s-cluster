        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "(sum by (route) (rate(traefik_service_requests_total[5m]))) * on (route) group_left (namespace, httproute, hostname) limitk(1, label_join(gateway_httproute_hostname_info, \"route\", \"-\", \"namespace\", \"httproute\")) by (route)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "(100 * sum by (route) (rate(traefik_service_requests_total[5m])) / scalar(sum(rate(traefik_service_requests_total[5m])))) * on (route) group_left (namespace, httproute, hostname) limitk(1, label_join(gateway_httproute_hostname_info, \"route\", \"-\", \"namespace\", \"httproute\")) by (route)",
