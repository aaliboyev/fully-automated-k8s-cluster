        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "(100 * sum by (route) (rate(traefik_service_requests_total{code=~\"4..\"}[5m])) / sum by (route) (rate(traefik_service_requests_total[5m])) or on (route) (0 * sum by (route) (rate(traefik_service_requests_total[5m])))) * on (route) group_left (namespace, httproute, hostname) limitk(1, label_join(gateway_httproute_hostname_info, \"route\", \"-\", \"namespace\", \"httproute\")) by (route)",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "(100 * sum by (route) (rate(traefik_service_requests_total{code=~\"5..\"}[5m])) / sum by (route) (rate(traefik_service_requests_total[5m])) or on (route) (0 * sum by (route) (rate(traefik_service_requests_total[5m])))) * on (route) group_left (namespace, httproute, hostname) limitk(1, label_join(gateway_httproute_hostname_info, \"route\", \"-\", \"namespace\", \"httproute\")) by (route)",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "(histogram_quantile(0.95, sum by (le, route) (rate(traefik_service_request_duration_seconds_bucket[5m])))) * on (route) group_left (namespace, httproute, hostname) limitk(1, label_join(gateway_httproute_hostname_info, \"route\", \"-\", \"namespace\", \"httproute\")) by (route)",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
