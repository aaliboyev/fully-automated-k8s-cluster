    {
      "type": "gauge",
      "title": "LINSTOR pool fill",
      "description": "The thin pool replicated volumes live in, per node.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sort_by_label(100 * (1 - linstor_storage_pool_capacity_free_bytes{storage_pool=\"data\"} / linstor_storage_pool_capacity_total_bytes{storage_pool=\"data\"}), \"node\")",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#e8743b",
                "value": null
              },
              {
                "color": "#ecd13a",
                "value": 80
              },
              {
                "color": "#d9367e",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
