  "panels": [
    {
      "type": "stat",
      "title": "Volumes out of sync",
      "description": "DRBD devices not UpToDate. A replicated volume keeps working on one copy, so this is the only place a lost replica shows.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "count(drbd_device_state{drbd_device_state!~\"UpToDate|Diskless\"} == 1) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "#d9367e",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "links": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      },
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      }
    },
